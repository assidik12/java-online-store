# ===================================================================
# RetailFlow — Environment variables untuk docker compose
# JANGAN COMMIT FILE INI DENGAN SECRET PRODUKSI!
# File ini hanya template. Copy ke .env dan isi secret asli.
# Generate APP_JWT_SECRET: openssl rand -base64 48
# Generate MYSQL_ROOT_PASSWORD: openssl rand -base64 24
# ===================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=java_toko_online
MYSQL_USER=retailflow
MYSQL_PASSWORD=retailflow_change_me
MYSQL_PORT=3306

# --- App ---
APP_PORT=8080

# --- JWT (WAJIB di-override!) ---
# Minimal 256-bit base64 (44 chars setelah encode). Contoh: buka terminal
# lalu jalankan: openssl rand -base64 48
APP_JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
